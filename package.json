{
  "name": "bundler-project",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "start": "VUE_AUTO_ROUTING=true vue-bundler-dev",
    "build": "VUE_AUTO_ROUTING=true vue-bundler",
    "build:vis": "BUILD_LIBRARY=src/vis/index vue-bundler",
    "tsc": "tsc -p tsconfig.prod.json && tsc-alias -p tsconfig.prod.json && copyfiles -u 1 \"src/**/*.d.ts\" dist",
    "pub": "qnpm publish"
  },
  "main": "dist/index.js",
  "files": [
    "dist"
  ],
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "resolutions": {
    "memfs": "^3.4.4"
  },
  "devDependencies": {
    "@types/d3-geo": "^3.0.2",
    "@types/three": "0.136.0",
    "eslint-config-bundler": "^0.1.1",
    "eslint-import-resolver-webpack": "^0.13.2",
    "msw": "^0.39.2",
    "stylelint": "^14.5.3",
    "stylelint-config-prettier": "^9.0.3",
    "stylelint-config-standard": "^25.0.0",
    "tsc-alias": "^1.6.4",
    "vue-bundler": "^0.1.21"
  },
  "dependencies": {
    "@q/design": "2.1.2",
    "@q/pencil": "1.6.15",
    "@tweenjs/tween.js": "^18.6.4",
    "d3-geo": "^3.0.1",
    "echarts": "^5.3.2",
    "gsap": "^3.10.4",
    "ky": "^0.30.0",
    "pinia": "^2.0.14",
    "tailwindcss": "^3.1.4",
    "three": "0.136.0",
    "vue": "^3.2.31",
    "vue-auto-routing": "^1.0.1",
    "vue-router": "^4.0.14"
  },
  "msw": {
    "workerDirectory": "public"
  }
}
